# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE)
# TUYỆT ĐỐI KHÔNG LƯU MẬT KHẨU THẬT VÀO ĐÂY
# ==========================================

# Môi trường chạy (development | production | test)
NODE_ENV=development

# Cổng mạng server lắng nghe
PORT=8000

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=demo_express
DB_CONNECTION_LIMIT=10

# Cấu hình JSON Web Token (JWT)
# Khóa bí mật dùng để ký và xác thực token (Ít nhất 32 ký tự ngẫu nhiên)
JWT_SECRET=super_secret_jwt_access_key_min_32_characters_2026
JWT_EXPIRES_IN=1h

# Refresh Token dùng để cấp mới Access Token khi hết hạn
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_characters_2026
JWT_REFRESH_EXPIRES_IN=7d
